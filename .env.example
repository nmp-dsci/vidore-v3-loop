# Copy to .env. Never commit .env.
#
# Billing is the Claude subscription through the Claude Agent SDK, as in tau2-loop:
# leave ANTHROPIC_API_KEY unset and be logged in to the Claude CLI (`claude login`).
BILLING=subscription
# ANTHROPIC_API_KEY=

# Central MLflow (nmp-central-ai; `make platform-up`). Never a local store.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1

# Where the Hugging Face datasets land (default: data/cache, gitignored).
# VIDORE_CACHE_DIR=
# HF_TOKEN=   # only if the Hub rate-limits anonymous downloads
